# Two variables are required. `npm run setup` fills both in for you.

# Any 32-byte random string. Setup generates one.
BETTER_AUTH_SECRET=""

# Encrypts the API credentials this app stores for you. Setup generates one.
# Change it and the stored credentials become unreadable, which is the point.
CREDENTIALS_SECRET=""

# Write the connection string out IN FULL. Nothing expands ${VARS} in a .env
# file, so a URL assembled from separate pieces arrives literally and fails.
#
# Option A - local Postgres in Docker, which `npm run setup` starts for you:
DATABASE_URL="postgresql://postgres:password@localhost:5432/dealroom"
#
# Option B - a hosted database you can manage in a browser. Neon
# (https://neon.tech) has a free tier and a SQL editor. Sign up, create a
# project, and paste the connection string it gives you:
# DATABASE_URL="postgresql://user:pw@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# Where this app runs. Only change it if you deploy somewhere.
APP_URL="http://localhost:3000"

# Keys are per user now, entered in Settings rather than set here — everyone
# running this brings their own. What is left is instance-wide.

XAI_MODEL="grok-4.5"

# Only if you are pointing extraction somewhere other than xAI.
# XAI_BASE_URL="https://api.x.ai/v1"

# Only if you are pointing the X API somewhere other than api.x.com.
# X_API_BASE_URL="https://api.x.com"

